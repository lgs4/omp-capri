    "mdQuoteBorder": "border",
    "mdHr": "border",
    "mdListBullet": "magenta",

    "toolDiffAdded": "green",
    "toolDiffRemoved": "error",
    "toolDiffContext": "secondary",

    "syntaxComment": "dimmed",
    "syntaxKeyword": "magenta",
    "syntaxFunction": "accent",
    "syntaxVariable": "foreground",
    "syntaxString": "green",
    "syntaxNumber": "warning",
    "syntaxType": "violet",
