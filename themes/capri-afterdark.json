{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/v18.16.0/packages/tui/src/theme/theme-schema.json",
  "name": "capri-afterdark",
  "vars": {
    "background": "#100C14",
    "surface": "#1B1420",
    "surfaceSuccess": "#10241B",
    "surfaceError": "#2B121C",
    "foreground": "#E5D9E3",
    "secondary": "#C2AEBB",
    "dimmed": "#806479",
