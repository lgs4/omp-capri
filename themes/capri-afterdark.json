  "colors": {
    "accent": "accent",
    "border": "border",
    "borderAccent": "accent",
    "borderMuted": "border",
    "success": "green",
    "error": "error",
    "warning": "warning",
    "muted": "secondary",
    "dim": "dimmed",
    "text": "foreground",
    "assistantMessageText": "foreground",
    "thinkingText": "secondary",

    "selectedBg": "border",
