{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/v18.16.0/packages/tui/src/theme/theme-schema.json",
  "name": "capri-afterdark-deck-lcd",
  "vars": {
    "background": "#120F16",
    "surface": "#211A24",
    "surfaceSuccess": "#10281F",
    "surfaceError": "#32151C",
    "foreground": "#F2EAF0",
    "secondary": "#C9BDC7",
